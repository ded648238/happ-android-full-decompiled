<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="4.0dp" />
            <gradient android:startColor="@android:color/transparent" android:endColor="@android:color/transparent" android:angle="180.0" />
            <stroke android:width="1.0dp" android:color="?subBgTraffic" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="4.0dp" />
                <gradient android:startColor="?subBgTraffic" android:endColor="?subBgTraffic" android:angle="180.0" />
            </shape>
        </clip>
    </item>
</layer-list>
