<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.0dp" android:color="?colorButtonEnabled" />
            <corners android:radius="@dimen/dialog_elevation" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.0dp" android:color="#52ffffff" />
            <corners android:radius="@dimen/dialog_elevation" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item android:bottom="-8.0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#80f2f2f2" />
                    <stroke android:width="0.0dp" />
                    <corners android:radius="@dimen/dialog_elevation" />
                </shape>
            </item>
            <item android:left="-8.0dp" android:top="-8.0dp" android:right="-8.0dp">
                <shape>
                    <stroke android:width="1.0dp" android:color="#52ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
